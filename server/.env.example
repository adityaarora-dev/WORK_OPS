PORT=5000
MONGODB_URI=your_mongodb_connection_string
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# --- Real Email OTP Dispatch Settings (SMTP) ---
# To deliver OTPs directly to any real email address (Gmail, Outlook, Yahoo, Corporate):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-16-digit-app-password
# EMAIL_FROM="HR Management System" <your-email@gmail.com>
#
# If SMTP is not configured, the system automatically uses real-time fallback mail dispatch.
