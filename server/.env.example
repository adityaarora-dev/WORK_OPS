# ==============================================================================
# Enterprise HRMS — Server Environment Variables
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
# Supports MONGO_URI or MONGODB_URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hrms_db?retryWrites=true&w=majority

# Frontend CORS Origin (Vercel deployment URL in production)
# Supports comma-separated list of origins
FRONTEND_URL=https://your-hrms-client.vercel.app

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_string_min_32_chars
JWT_EXPIRES_IN=24h

# --- Real Email Dispatch Settings (Google SMTP) ---
# Supports SMTP_EMAIL / SMTP_USER and SMTP_PASSWORD / SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-company-email@gmail.com
SMTP_PASSWORD=your-google-16-digit-app-password
EMAIL_FROM="HR Management System" <your-company-email@gmail.com>
