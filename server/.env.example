# ==============================================================================
# Enterprise HRMS — Server Environment Variables
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
# Supports either MONGODB_URI or MONGO_URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hrms_db?retryWrites=true&w=majority

# Frontend CORS Origin & Dynamic Link Resolution (Vercel deployment URL)
# Supports comma-separated list of origins
FRONTEND_URL=https://workops-22.vercel.app
CLIENT_URL=https://workops-22.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_string_min_32_chars
JWT_EXPIRES_IN=24h

# --- Resend Email Provider Configuration ---
# Permanent email service for production and local environments
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="HR Management System <onboarding@resend.dev>"
EMAIL_FROM="HR Management System <onboarding@resend.dev>"
# Note: In production with a verified domain (resend.com/domains), update RESEND_FROM to:
# RESEND_FROM="HR Management System <noreply@yourdomain.com>"
